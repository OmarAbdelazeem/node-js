# Server
PORT=3000
BASE_URL=https://your-public-domain.com

# Paymob (Create Intention API for Mobile SDK)
# Secret key: Dashboard → Account Info → Secret Key. Required for POST /v1/intention/
PAYMOB_SECRET_KEY=your_paymob_secret_key
PAYMOB_HMAC_SECRET=your_hmac_secret
PAYMOB_INTEGRATION_ID_CARD=your_cards_integration_id
# Optional: public key returned in session; if omitted, app uses build-time key
# PAYMOB_PUBLIC_KEY=your_public_key
# Optional: intention API base (default from PAYMOB_API_BASE without /api, or Egypt)
# PAYMOB_INTENTION_BASE=https://accept.paymob.com
PAYMOB_API_BASE=https://accept.paymob.com/api

# Optional: storage (omit or false = in-memory)
# SQLite (single file, no server):
# USE_DB=sqlite
# DATABASE_PATH=./data/paymob.db
# Postgres:
# USE_DB=true
# DATABASE_URL=postgres://user:password@localhost:5432/paymob_demo
USE_DB=false
DATABASE_URL=postgres://user:password@localhost:5432/paymob_demo
DATABASE_PATH=./data/paymob.db

# Demo only: skip HMAC verification for webhook (default false)
DEV_BYPASS_HMAC=false

# Optional: deep link for mobile redirect after payment (e.g. myapp://payment/complete).
# When set, GET /payments/paymob/callback returns HTML that redirects to this URL with query params from Paymob.
# PAYMENT_CALLBACK_DEEP_LINK=myapp://payment/complete

# Optional: ngrok tunnel from the app (no separate CLI). Add your token from https://dashboard.ngrok.com/get-started/your-authtoken
# When set, the server will create a public URL on startup and print the webhook and callback URLs.
# NGROK_AUTHTOKEN=your_ngrok_authtoken

# Saved cards: requests to /users/me/cards require header X-User-Id (opaque user/device id).
# For production, replace with real auth (JWT/session); the same user id can be the JWT subject.

